#!/usr/bin/env bash
#
# Put the two browser dependencies under public/vendor/, once.
#
# SPEC §12.2 decides three things this implements. §10.3 forbids loading
# anything from an origin this site does not control, so a CDN is out. §12.0
# promises one language runtime, so a clone must not need npm — which is why
# **the output of this script is committed** and running it is not part of
# `composer install && bin/build-content && bin/run-dev`. And neither dependency
# needs a bundler: sol-pay's package is `wasm-pack --target web` output, plain
# ESM beside a .wasm, and kit ships a self-contained IIFE with no bare
# specifiers.
#
# So this is a maintainer's script, run when a version changes, and its diff is
# third-party code entering the repository deliberately. That is the exception
# §12.2 names, not the general rule.
#
# Requires npm and network — neither of which exists in the environments Claude
# runs in, which is why this is yours to run. Every step says what it did, and
# the script checks its own output at the end rather than trusting that a copy
# succeeded.

set -uo pipefail

SOL_PAY_VERSION="${SOL_PAY_VERSION:-0.1.1}"
KIT_VERSION="${KIT_VERSION:-latest}"

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
out="$root/public/vendor"
work="$(mktemp -d)"
trap 'rm -rf "$work"' EXIT

die() { echo "vendor-assets: $*" >&2; exit 1; }

command -v npm >/dev/null || die "npm is not on PATH"

# `npm pack` rather than `npm install`: no node_modules, no package.json and no
# lockfile enter this repository — only the files that are served.
fetch() { # spec, subdirectory
    local spec="$1" dir="$2" tgz
    echo "  npm pack $spec"
    tgz="$( cd "$work" && npm pack "$spec" --silent 2>"$work/npm.err" )" || {
        echo "--- npm said ---" >&2
        cat "$work/npm.err" >&2
        die "could not fetch $spec. If the version is the problem, 'npm view ${spec%@*} versions' lists what exists, and SOL_PAY_VERSION=x.y.z bin/vendor-assets overrides it."
    }
    mkdir -p "$work/$dir"
    tar -xzf "$work/$tgz" -C "$work/$dir" --strip-components=1 || die "could not unpack $tgz"
    rm -f "$work/$tgz"
}

need() { [ -f "$1" ] || die "expected $1 after unpacking — the package layout has changed"; }

echo "vendoring into public/vendor/"

# --- sol-pay's own package (§12.2, and §3's browser consumer) ---------------
# ESM plus the wasm beside it: `init()` fetches the .wasm relative to the .js,
# so the two must land in the same directory.
if [ -n "${SOL_PAY_PKG:-}" ]; then
    # An escape hatch for developing against an unpublished build:
    #   SOL_PAY_PKG=../sol-pay/wasm-client/pkg bin/vendor-assets
    # Worth knowing you used it — a vendored file from a working tree is not a
    # file anyone else can reproduce.
    echo "  using SOL_PAY_PKG=$SOL_PAY_PKG instead of npm"
    mkdir -p "$work/sol-pay"
    cp -R "$SOL_PAY_PKG/." "$work/sol-pay/" || die "could not read $SOL_PAY_PKG"
else
    fetch "sol-pay-client@$SOL_PAY_VERSION" sol-pay
fi

need "$work/sol-pay/sol_pay_client.js"
need "$work/sol-pay/sol_pay_client_bg.wasm"
mkdir -p "$out/sol-pay-client"
cp "$work/sol-pay/sol_pay_client.js" \
   "$work/sol-pay/sol_pay_client_bg.wasm" \
   "$out/sol-pay-client/" || die "could not copy the sol-pay files"
cp "$work/sol-pay/sol_pay_client.d.ts" "$out/sol-pay-client/" 2>/dev/null || true
cp "$work/sol-pay/LICENSE-MIT" "$work/sol-pay/LICENSE-APACHE" "$out/sol-pay-client/" 2>/dev/null || true

# --- @solana/kit, for message compilation and nothing else ------------------
# The production IIFE: no bare specifiers, exposes globalThis.solanaWeb3. The
# ESM build is an aggregator over fifteen sibling @solana/* packages and would
# need an import map over the whole graph, which is what §12.2 declined.
fetch "@solana/kit@$KIT_VERSION" kit
need "$work/kit/dist/index.production.min.js"
mkdir -p "$out/solana-kit"
cp "$work/kit/dist/index.production.min.js" "$out/solana-kit/kit.min.js" || die "could not copy kit"
cp "$work/kit/LICENSE" "$out/solana-kit/" 2>/dev/null || true

# Provenance, written down beside the files. A vendored file nobody can trace
# is a file nobody can audit or update.
sol_pay_version="$(node -p "require('$work/sol-pay/package.json').version" 2>/dev/null || echo unknown)"
kit_version="$(node -p "require('$work/kit/package.json').version" 2>/dev/null || echo unknown)"
{
    echo "# Vendored browser dependencies"
    echo
    echo "Generated by \`bin/vendor-assets\` on $(date -u +%Y-%m-%d). Committed"
    echo "deliberately (SPEC §12.2): §10.3 forbids a CDN and §12.0 promises a"
    echo "clone needs only PHP. Do not edit these by hand — re-run the script."
    echo
    echo "| package | version | file |"
    echo "| --- | --- | --- |"
    echo "| sol-pay-client | $sol_pay_version${SOL_PAY_PKG:+ (from a working tree, not npm)} | \`sol-pay-client/sol_pay_client.js\` + \`.wasm\` |"
    echo "| @solana/kit | $kit_version | \`solana-kit/kit.min.js\` |"
} > "$out/README.md"

echo
echo "done:"
find "$out" -type f | sort | while read -r f; do
    printf '  %8s  %s\n' "$(wc -c < "$f" | tr -d ' ')" "${f#"$root"/}"
done
echo
echo "These files are committed on purpose."
