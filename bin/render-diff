    $f['setup-provisioned'] = ['setup', ['status' => $status(['provisioned' => true]), 'error' => null, 'site' => $site, 'setup' => []]];
    $f['setup-ready'] = ['setup', ['status' => $status(), 'error' => null, 'site' => $site, 'setup' => []]];
    $f['setup-unfunded'] = ['setup', ['status' => $status(['funded' => false, 'balance' => 0]), 'error' => null, 'site' => $site, 'setup' => []]];
    $f['setup-undeployed'] = ['setup', ['status' => $status(['program_deployed' => false]), 'error' => null, 'site' => $site, 'setup' => []]];
    $f['setup-ran-done'] = ['setup-ran', ['provisioned' => true, 'steps' => $steps]];
    $f['setup-ran-stopped'] = ['setup-ran', ['provisioned' => false, 'steps' => $steps]];

    // §9's panel, assembled by `Inspector` and rendered by its templates — so
    // these cover the class as well as the markup, which is the half a
    // template-only fixture cannot reach.
    $f['panel-deferred'] = ['inspector', ['sections' => null]];
    $f['panel-site-only'] = ['inspector', ['sections' => $sections($state())]];
    $f['panel-error'] = ['inspector-sections', ['sections' => $sections(null, 'getMultipleAccounts: HTTP 429')]];
    $f['panel-unprovisioned'] = ['inspector-sections', ['sections' => $sections()]];
    $f['panel-drift'] = ['inspector-sections', ['sections' => $sections($state(20000))]];
    $f['panel-reader'] = ['inspector-sections', ['sections' => $sections($state(), null, $payer())]];
    $f['panel-reader-nofunds'] = ['inspector-sections', ['sections' => $sections($state(), null, $payer(true, false))]];
    $f['panel-no-contract'] = ['inspector-sections', ['sections' => $sections($state(), null, $payer(false))]];
    $f['panel-metered'] = ['inspector-sections', ['sections' => $sections($state(), null, $payer(), $metered)]];
    $f['panel-browser-built'] = ['inspector-sections', ['sections' => $sections($state(), null, $payer(), $R::metered($SIG, 10000, true))]];
    $f['panel-no-decimals'] = ['inspector-sections', ['sections' => $sections($state(10000, null), null, $payer())]];

    return $f;
}
