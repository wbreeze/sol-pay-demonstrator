#!/usr/bin/env php
<?php

declare(strict_types=1);

/**
 * Did that change the page?
 *
 * The suite answers a narrower question than it looks like it does. It asserts
 * what somebody thought to assert, so a refactor can move a sentence, drop an
 * attribute, nest a paragraph inside a list item, and leave every test green —
 * because no test was watching that part. Reviewing the diff does not close it
 * either: a template diff shows what the *source* did, and the source is not
 * what a reader sees.
 *
 * So this renders every branch of every template twice — once from this
 * working tree, once from a git ref — and compares the output. Identical means
 * the refactor was a refactor. Anything else is named, branch by branch, which
 * is also how to use it on purpose: point it at a change you meant to make and
 * it says exactly which screens moved and which did not.
 *
 *   bin/render-diff            this tree against HEAD
 *   bin/render-diff master     this tree against a ref
 *   bin/render-diff --list     the fixtures, by name
 *
 * Exit 0 when nothing moved, 1 when something did, 2 on an error. **Exit 1 is
 * information, not a failure** — the same convention `bin/upstream-drift`
 * uses. A deliberate change is supposed to move something.
 *
 * **What is compared, and what is not.** Whitespace between and around tags is
 * normalised away, and so is entity spelling: `&#039;` and `&quot;` and a bare
 * `'` compare equal, because a renderer that changes how it escapes a quote
 * has not changed the page. What is left is the markup and the words. That
 * tolerance is deliberate — commonmark writes a paragraph on one line where a
 * template indents it, and without this the first run is four hundred lines of
 * indentation and nobody reads the second.
 *
 * **How it reaches the other tree.** `git archive <ref>` into a temporary
 * directory — a read, so it runs against a repository in any state — and then
 * the two renders happen in two processes, each with that tree's `src/` in
 * front of the autoloader. Third-party code is taken from this tree's
 * `vendor/` in both, because it is the same code: if `composer.lock` differs
 * between the two, this says so and stops rather than quietly attributing a
 * library's change to a template.
 *
 * **What it cannot do.** The fixtures below construct value objects — a
 * `Piece`, a `MeterResult`, a panel array — so a change to one of *those*
 * shapes breaks the render rather than being compared. That is the honest
 * failure: the tool is for changes that leave the data alone, which is what a
 * copy, markup or layout refactor is. When it dies constructing a fixture, the
 * answer is that this was not that kind of change.
 */

const USAGE = <<<'TXT'
    bin/render-diff [<ref>]     compare this working tree against <ref> (default HEAD)
    bin/render-diff --list      name the fixtures
    TXT;

$root = dirname(__DIR__);

// The `--render` mode is this script talking to itself, once per tree. It is
// not in the usage because nobody should need it: the point of two processes
// is that each has exactly one `Newsprint\` on its autoloader, so a fixture is
// always built from the same tree whose templates render it.
if (($argv[1] ?? null) === '--render') {
    render($root, (string) $argv[2], (string) $argv[3]);
    exit(0);
}

if (in_array($argv[1] ?? '', ['-h', '--help'], true)) {
    echo USAGE, "\n";
    exit(0);
}

if (($argv[1] ?? null) === '--list') {
    require $root.'/vendor/autoload.php';
    foreach (array_keys(fixtures($root)) as $name) {
        echo '  ', $name, "\n";
    }
    exit(0);
}

$ref = $argv[1] ?? 'HEAD';
exit(compare($root, $ref));

/**
 * Render every fixture of one tree into one directory.
 *
 * `$here` is where this script lives and where `vendor/` is taken from;
 * `$tree` is the tree whose `src/` and `templates/` are under test. Diagnostics
 * are promoted to exceptions and then caught per fixture, so a template that
 * reads a key it was not given is a difference rather than a silent empty
 * string — and a fixture that throws in one tree and not the other shows up as
 * the difference it is.
 */
function render(string $here, string $tree, string $out): void
{
    require $here.'/vendor/autoload.php';

    // In front of composer's, so `Newsprint\` resolves to the tree under test
    // while `SolPay\` and everything else stays this tree's. The two are the
    // same code — `compare()` refuses to run when the locks disagree.
    spl_autoload_register(static function (string $class) use ($tree): void {
        if (!str_starts_with($class, 'Newsprint\\')) {
            return;
        }
        $file = $tree.'/src/'.str_replace('\\', '/', substr($class, strlen('Newsprint\\'))).'.php';
        if (is_file($file)) {
            require $file;
        }
    }, true, true);

    @mkdir($out, 0777, true);

    $view = new Newsprint\Support\View($tree.'/templates');

    foreach (fixtures($tree) as $name => [$template, $vars]) {
        set_error_handler(static function (int $severity, string $message, string $file, int $line): bool {
            throw new ErrorException($message.' in '.basename($file).' line '.$line, 0, $severity, $file, $line);
        });

        try {
            $html = $view->render($template, $vars);
        } catch (Throwable $e) {
            $html = '*** '.$e::class.': '.$e->getMessage();
        } finally {
            restore_error_handler();
        }

        file_put_contents($out.'/'.$name.'.html', $html);
    }
}

/** Archive the ref, render both, report. */
function compare(string $root, string $ref): int
{
    $tmp = sys_get_temp_dir().'/render-diff-'.getmypid();
    $base = $tmp.'/tree';
    @mkdir($base, 0777, true);

    // A read, deliberately: this runs against a repository in any state, and
    // takes no lock — see `GIT_OPTIONAL_LOCKS`.
    $archive = sprintf(
        'GIT_OPTIONAL_LOCKS=0 git -C %s archive %s | tar x -C %s',
        escapeshellarg($root),
        escapeshellarg($ref),
        escapeshellarg($base),
    );
    exec($archive, $ignored, $status);
    if ($status !== 0) {
        fwrite(STDERR, "could not archive {$ref}\n");

        return 2;
    }

    // Third-party code is taken from this tree for both renders. That is only
    // honest while it is the same third-party code.
    if (md5_file($root.'/composer.lock') !== md5_file($base.'/composer.lock')) {
        fwrite(STDERR, "composer.lock differs between this tree and {$ref}.\n");
        fwrite(STDERR, "Both renders would use this tree's vendor/, so a library's change\n");
        fwrite(STDERR, "would be reported as a template's. Compare against a ref with the\n");
        fwrite(STDERR, "same lock, or install the other tree's dependencies and diff by hand.\n");

        return 2;
    }

    $self = escapeshellarg(__FILE__);
    foreach ([['before', $base], ['after', $root]] as [$which, $tree]) {
        exec(sprintf('php %s --render %s %s', $self, escapeshellarg($tree), escapeshellarg($tmp.'/'.$which)), $ignored, $status);
        if ($status !== 0) {
            fwrite(STDERR, "the {$which} render failed\n");

            return 2;
        }
    }

    return report($tmp.'/before', $tmp.'/after', $ref);
}

/**
 * What is the same, what moved, and where.
 *
 * The first divergence with its context is what a reader wants: a changed
 * screen is usually one changed sentence, and a full diff of normalised markup
 * buries it.
 */
function report(string $before, string $after, string $ref): int
{
    $changed = [];
    $names = array_map(
        static fn (string $f): string => basename($f, '.html'),
        glob($before.'/*.html') ?: [],
    );

    foreach ($names as $name) {
        $a = normalise((string) file_get_contents($before.'/'.$name.'.html'));
        $b = normalise((string) file_get_contents($after.'/'.$name.'.html'));

        if ($a === $b) {
            continue;
        }

        $changed[] = $name;
        $at = 0;
        $limit = min(strlen($a), strlen($b));
        while ($at < $limit && $a[$at] === $b[$at]) {
            ++$at;
        }
        $from = max(0, $at - 60);

        printf("\n  %s\n", $name);
        printf("    − %s\n", trim(substr($a, $from, 170)));
        printf("    + %s\n", trim(substr($b, $from, 170)));
    }

    printf(
        "\n%d fixtures against %s: %d changed, %d identical\n",
        count($names),
        $ref,
        count($changed),
        count($names) - count($changed),
    );

    return $changed === [] ? 0 : 1;
}

/**
 * Markup and words, with the two things that are not either of them removed.
 *
 * Whitespace around a tag is the renderer's business — commonmark writes a
 * paragraph on one line where a template indents it — and entity spelling is
 * the escaper's: `&#039;`, `&quot;` and the characters themselves say the same
 * thing to a reader. Whitespace *inside* text is collapsed rather than
 * dropped, because two words running together is a change.
 */
function normalise(string $html): string
{
    $s = html_entity_decode($html, ENT_QUOTES | ENT_HTML5, 'UTF-8');
    $s = (string) preg_replace('/\s+/u', ' ', $s);
    $s = (string) preg_replace('/\s*(<[^>]*>)\s*/u', '$1', $s);

    return trim($s);
}

/**
