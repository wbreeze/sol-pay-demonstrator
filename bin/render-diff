            210000,
        );

    $solvency = static function (int $bal, int $allow, bool $delegate = true) use ($shortfall): array {
        $s = $shortfall($bal, $allow, $delegate);

        return [
            'would_move' => '0.21',
            'balance_short' => $s->balanceShort, 'balance_short_demo' => '0.08',
            'allowance_short' => $s->allowanceShort, 'allowance_short_demo' => '0.05',
