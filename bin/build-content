#!/usr/bin/env php
<?php

declare(strict_types=1);

/**
 * Render `content/*.md` into `var/content/` (SPEC §12.7).
 *
 * Content files rendered once, not a CMS: §12.1 rejected one partly because
 * page and template caching is actively hostile to per-request metering —
 * either the cache serves an unpaid reader or the CMS runs with its main
 * feature off. Rendering ahead of time has neither problem, because what is
 * cached is the *article*, and whether a reader may see it is decided per
 * request by §7 and nothing else.
 *
 * Output is gitignored. A clone runs `composer install && bin/build-content`
 * before `php -S`, which is one more step than §12.0's promise and the price
 * of not committing generated files.
 *
 * Usage:  bin/build-content [--quiet]
 *
 * `NEWSPRINT_CONTENT_SOURCE` and `NEWSPRINT_CONTENT_TARGET` move the two
 * directories, which is how a test drives this script over a fixture instead of
 * over `content/`. The front matter rules below are refusals a reader never
 * sees, and a refusal nothing exercises is a refusal that can quietly stop
 * refusing.
 */

use League\CommonMark\Extension\FrontMatter\Output\RenderedContentWithFrontMatter;
use Newsprint\Content\Markdown;

require __DIR__.'/../vendor/autoload.php';

/**
 * commonmark lists `symfony/yaml` as a *suggestion* rather than a
 * requirement — "v2.3+ required if using the Front Matter extension" — so
 * installing commonmark alone leaves the front matter parser throwing from
 * three frames inside the library. `composer.json` requires it explicitly;
 * this is here so that a stale `vendor/` says one sentence instead of forty
 * lines of stack trace.
 */
if (!class_exists(\Symfony\Component\Yaml\Yaml::class)) {
    fwrite(STDERR, "symfony/yaml is missing — front matter cannot be parsed without it. Run: composer update\n");
    exit(1);
}

$root = dirname(__DIR__);
$source = (string) (getenv('NEWSPRINT_CONTENT_SOURCE') ?: $root.'/content');
$target = (string) (getenv('NEWSPRINT_CONTENT_TARGET') ?: $root.'/var/content');
$quiet = in_array('--quiet', $argv, true);

if (!is_dir($target) && !mkdir($target, 0o755, true) && !is_dir($target)) {
    fwrite(STDERR, "cannot create {$target}\n");
    exit(1);
}

// The dialect, and the argument for where it lives, are in `Content\Markdown`.
$converter = Markdown::converter();

$manifest = [];
$skipped = [];

foreach (glob($source.'/*.md') ?: [] as $path) {
    $name = basename($path);
    $rendered = $converter->convert((string) file_get_contents($path));

    // §10.1 says every piece carries front matter. A file without it is a
    // working note that happens to live here — MeteredPayEconomics.md is one,
    // filed against sol-pay rather than written for readers — so it is skipped
    // and named rather than silently published or silently dropped.
    if (!$rendered instanceof RenderedContentWithFrontMatter) {
        $skipped[] = $name;
        continue;
    }

    $front = $rendered->getFrontMatter();
    $metered = (bool) ($front['metered'] ?? true);

    // A lede is required of a *metered* piece and of nothing else, because of
    // what it is for: §6.1 wants something honest to render beside the meter
    // to a visitor with no contract. A public page — the privacy page (§10.2)
    // — is served whole, so there is nothing to stand in for.
    $required = $metered ? ['title', 'slug', 'lede', 'created'] : ['title', 'slug', 'created'];
    foreach ($required as $key) {
        if (!isset($front[$key])) {
            $hint = match ($key) {
                'lede' => " (metered pieces need one; set 'metered: false' for a public page)",
                'created' => " (the day it was written, YYYY-MM-DD; add 'revised' when it changes)",
                default => '',
            };
            fwrite(STDERR, "{$name}: front matter has no '{$key}'".$hint."\n");
            exit(1);
        }
    }

    // The dates are the writer's, like `reading_time` below, and the same
    // sentence applies: a date the writer sets is a promise to a reader, and
    // one derived from the repository is a fact about a commit. What the build
    // owes them is the shape — `bin/content-dates` is what asks whether the
    // promise is still true.
    $dates = [];
    foreach (['created', 'revised'] as $key) {
        if (!isset($front[$key])) {
            continue;
        }

        // What YAML hands back for a date is not a date. `symfony/yaml` parses
        // an unquoted `2026-09-07` into a **Unix timestamp**, a quoted one
        // into a string, and would give a `DateTimeImmutable` only under a
        // flag the front matter extension does not pass. All three are
        // accepted here and all three end up as one spelling, because the
        // alternative is a front matter key whose meaning depends on whether
        // the writer used quotes.
        $raw = $front[$key];
        if ($raw instanceof \DateTimeInterface) {
            $value = $raw->format('Y-m-d');
        } elseif (is_int($raw)) {
            $value = gmdate('Y-m-d', $raw);
        } else {
            $value = trim((string) $raw);
        }

        $parsed = \DateTimeImmutable::createFromFormat('!Y-m-d', $value, new \DateTimeZone('UTC'));
        if ($parsed === false || $parsed->format('Y-m-d') !== $value) {
            fwrite(STDERR, "{$name}: '{$key}' is '{$value}'; it must be a date written YYYY-MM-DD\n");
            exit(1);
        }

        // A date in the future is always a mistake and never a plan: the build
        // runs when it runs, and nothing here schedules anything.
        if ($parsed->format('Y-m-d') > (new \DateTimeImmutable('today', new \DateTimeZone('UTC')))->format('Y-m-d')) {
            fwrite(STDERR, "{$name}: '{$key}' is {$value}, which has not happened yet\n");
            exit(1);
        }

        $dates[$key] = $value;
    }

    if (isset($dates['revised']) && $dates['revised'] < $dates['created']) {
        fwrite(STDERR, "{$name}: 'revised' ({$dates['revised']}) is before 'created' ({$dates['created']})\n");
        exit(1);
    }

    $slug = (string) $front['slug'];
    if (preg_match('/^[a-z0-9][a-z0-9-]*$/', $slug) !== 1) {
        fwrite(STDERR, "{$name}: '{$slug}' is not a usable slug\n");
        exit(1);
    }

    // `status` decides whether a piece is published, and nothing checked it.
    // The default when the key is absent is `published`, and every reader of
    // the value asks `=== 'draft'` — `Piece::isDraft()` and `DateAudit` both —
    // so a typo does not fall back to the safe answer. It publishes. A draft
    // spelled `draftt` would go out with its dates unaudited, which is the one
    // mistake in this file that a reader sees before anybody else does.
    $status = (string) ($front['status'] ?? 'published');
    if (!in_array($status, ['draft', 'published'], true)) {
        fwrite(STDERR, "{$name}: 'status' is '{$status}'; it must be 'draft' or 'published'\n");
        exit(1);
    }

    $body = $rendered->getContent();

    // The title is written once, in the front matter, and rendered once, by
    // `article.php` and `page.php`. A body that opens with its own `#` heading
    // renders the title twice on every paid article, and — worse than the
    // repetition — makes it possible for the two to disagree. Refused here so
    // that they cannot: there is one place a piece is titled.
    if (preg_match('/<h1[\s>]/i', $body) === 1) {
        fwrite(STDERR, "{$name}: the body carries an <h1>; the title comes from front matter and is rendered by the template. Remove the '# ' heading.\n");
        exit(1);
    }

    file_put_contents($target.'/'.$slug.'.html', $body);

    // 238 words a minute, rounded up, and only when the piece does not say.
    // A number the writer sets is a promise to the reader; a number counted
    // from the text is an estimate, and they should not be confused.
    $words = str_word_count(strip_tags($body));
    $manifest[] = [
        'slug' => $slug,
        'title' => (string) $front['title'],
        'lede' => trim((string) ($front['lede'] ?? '')),
        'reading_time' => (int) ($front['reading_time'] ?? max(1, (int) ceil($words / 238))),
        'metered' => $metered,
        'status' => $status,
        'created' => $dates['created'],
        'revised' => $dates['revised'] ?? null,
        'source' => $name,
        'words' => $words,
    ];

    if (!$quiet) {
        printf("  %-28s %-24s %5d words  %s\n", $name, $slug, $words, $metered ? 'metered' : 'public');
    }
}

// Stale output is worse than missing output: a renamed slug would otherwise
// leave the old article on disk, still servable, still charged for.
foreach (glob($target.'/*.html') ?: [] as $built) {
    $slug = basename($built, '.html');
    if (!in_array($slug, array_column($manifest, 'slug'), true)) {
        unlink($built);
        if (!$quiet) {
            echo "  removed {$slug}.html (no longer in content/)\n";
        }
    }
}

file_put_contents($target.'/index.json', json_encode($manifest, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE)."\n");

if (!$quiet) {
    foreach ($skipped as $name) {
        echo "  skipped {$name} — no front matter, so not a piece (§10.1)\n";
    }
    printf("\n%d piece%s built into var/content\n", count($manifest), count($manifest) === 1 ? '' : 's');
}
