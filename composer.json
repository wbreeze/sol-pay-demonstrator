{
    "name": "wbreeze/newsprint",
    "description": "Newsprint — the sol-pay demonstrator. A site that meters articles with sol-pay on devnet, against a token it issues itself.",
    "type": "project",
    "license": "(MIT or Apache-2.0)",
    "homepage": "https://github.com/wbreeze/sol-pay-demonstrator",
    "require": {
        "php": "^8.1",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-pdo_sqlite": "*",
        "ext-sodium": "*",
        "league/commonmark": "^2.7",
        "slim/psr7": "^1.7",
        "slim/slim": "^4.15",
        "symfony/yaml": "^6.4 || ^7.0",
        "wbreeze/sol-pay-client": "^0.1.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Newsprint\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Newsprint\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "serve": "php -S localhost:8000 -t public"
    },
    "config": {
        "sort-packages": true
    }
}
